{
  "name": "pagato-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pwa:prepare": "node scripts/prepare-pwa.mjs",
    "predev": "npm run pwa:prepare",
    "prebuild": "npm run pwa:prepare",
    "test:pwa": "node tests/ui/pwa-check.mjs",
    "pretest:pwa:production": "npm run build",
    "test:pwa:production": "node tests/ui/pwa-production-check.mjs",
    "security:secrets": "node scripts/security-check.mjs",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run security:secrets && npm run security:dependencies",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:db": "node --conditions=react-server tests/integration/profile-check.mjs",
    "test:accounts:db": "node --conditions=react-server tests/integration/accounts-check.mjs",
    "test:categories:db": "node --conditions=react-server tests/integration/categories-check.mjs",
    "test:transactions:db": "node --conditions=react-server tests/integration/transactions-check.mjs",
    "test:transactions:concurrency": "node --conditions=react-server tests/integration/transactions-concurrency-check.mjs",
    "test:budgets:db": "node --conditions=react-server tests/integration/budgets-check.mjs",
    "test:budgets:ui": "node tests/ui/budgets-check.mjs",
    "test:plans:db": "node --conditions=react-server tests/integration/monthly-plans-check.mjs",
    "test:plans:ui": "node tests/ui/budgets-check.mjs --monthly",
    "test:motion:ui": "node tests/ui/budgets-check.mjs --motion",
    "test:dashboard:db": "node --conditions=react-server tests/integration/dashboard-check.mjs",
    "test:dashboard:ui": "node tests/ui/dashboard-check.mjs",
    "test:preferences:db": "node --conditions=react-server tests/integration/preferences-check.mjs",
    "test:preferences:ui": "node tests/ui/preferences-check.mjs",
    "db:preferences:validate": "node scripts/migrate-preferences.mjs",
    "db:preferences:apply": "node scripts/migrate-preferences.mjs --apply",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
