# Neon pooled endpoint used only by server-side application code.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=verify-full&channel_binding=require"

# Neon direct endpoint used by Drizzle migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=verify-full&channel_binding=require"

# Values provided when Neon Auth is enabled on the development branch.
NEON_AUTH_BASE_URL="https://YOUR_NEON_AUTH_HOST/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-random-characters"

# Public origin used only to build password-reset callback URLs.
APP_URL="http://localhost:3000"

# Public support address shown in privacy and terms pages. Use a real monitored inbox before launch.
SUPPORT_EMAIL="YOUR_SUPPORT_EMAIL"
