# Use the pooled Neon endpoint for the application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=verify-full&channel_binding=require"

# Use the direct Neon endpoint only for migrations and administrative tasks.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=verify-full&channel_binding=require"

# Generate a unique secret per environment. Never commit a real value.
AUTH_SECRET="replace-with-a-cryptographically-random-secret"
